<View>
  <Header value="$video_id | exported time $time_sec s | source time $source_time_sec s" />
  <Header value="先完整播放该 30 秒标注片段并打开声音，再按 1 fps 图片顺序标注。不要看 query、类别、抽样原因、模型预测或其他人的结果。" />
  <Header value="0. 先看完整标注片段：点击下方播放并打开声音。同一 video_id 看完一次即可；切换 video_id 后重新完整观看。播放器时间是片段内时间，当前图片位于第 $time_sec 秒。" />
  <HyperText name="context_player" value="$context_player" />
  <Header value="判断树：能指出具体事件/信息/变化吗？不能且确定普通=0；不能且证据不足=不确定；能但只是背景=1；有独立保留价值=2；结果/峰值/不可替代=3。清晰、居中、运动大、画面漂亮或开头结尾不能单独构成高光。" />

  <Image name="image" value="$image" zoom="true" />

  <Header value="1. 通用高光等级（按同一视频内部相对判断）。整段没有高光可以全部标0/1，不必凑出2/3。" />
  <Choices name="generic_highlight" toName="image" choice="single-radio" showInline="true" required="true">
    <Choice value="0普通" />
    <Choice value="1有信息" />
    <Choice value="2值得保留" />
    <Choice value="3高光核心" />
    <Choice value="不确定" />
  </Choices>

  <Header value="2. 事件阶段：结果和反应同时出现时，按当前帧主要保留价值选择。" />
  <Choices name="event_phase" toName="image" choice="single-radio" showInline="true" required="true">
    <Choice value="铺垫" />
    <Choice value="进行中" />
    <Choice value="完成或结果" />
    <Choice value="结果后反应" />
    <Choice value="无事件或无法判断" />
  </Choices>

  <Header value="3. 信息依赖（0/1可跳过；2/3请填写）：为了知道这一帧为什么值得保留，需要什么信息？不是问你实际有没有看过视频。" />
  <Header value="当前帧足够：这张图已能说明价值；需要前后过程：要看动作前后才知道成功/失败；需要声音或语言：要听台词、语气或掌声才懂；无法判断：看完仍不知道价值来源。同时需要过程与声音时选声音，并在备注补充。" />
  <Choices name="needs_context" toName="image" choice="single-radio" showInline="true" required="false">
    <Choice value="当前帧足够" />
    <Choice value="需要前后过程" />
    <Choice value="需要声音或语言" />
    <Choice value="无法判断" />
  </Choices>

  <Choices name="event_type" toName="image" choice="single-radio" showInline="true" required="true">
    <Choice value="动作" />
    <Choice value="结果或揭示" />
    <Choice value="情绪或反应" />
    <Choice value="人物互动" />
    <Choice value="信息或字幕" />
    <Choice value="视觉奇观或场景" />
    <Choice value="其他" />
    <Choice value="无事件" />
  </Choices>

  <!-- Retain the legacy field for existing results; blind-pass policy is
       project metadata and no longer requires a per-frame confirmation. -->
  <View style="display: none;">
    <Choices name="query_relevance" toName="image" choice="single-radio" showInline="true" required="false">
      <Choice value="未看查询" />
    </Choices>
  </View>

  <Choices name="confidence" toName="image" choice="single-radio" showInline="true" required="true">
    <Choice value="高" />
    <Choice value="中" />
    <Choice value="低" />
  </Choices>

  <Header value="仅当通用高光为 2 或 3 时考虑画框。本批次没有 targetRatioWH，框是自由比例的构图可行性诊断，不是官方 native crop GT，也不是紧致检测框。没有稳定合理窗口就不画。" />
  <RectangleLabels name="crop_box" toName="image" smart="true">
    <Label value="主体" background="#1f77b4" />
    <Label value="多人或互动" background="#ff7f0e" />
    <Label value="整体画面或景别" background="#2ca02c" />
    <Label value="字幕或屏幕信息" background="#d62728" />
  </RectangleLabels>
  <Choices name="crop_reason" toName="image" choice="multiple" showInline="true">
    <Choice value="主体完整" />
    <Choice value="动作关系" />
    <Choice value="结果信息" />
    <Choice value="字幕保留" />
    <Choice value="整体构图" />
  </Choices>
  <Choices name="composition_confidence" toName="image" choice="single-radio" showInline="true">
    <Choice value="高" />
    <Choice value="中" />
    <Choice value="低或无合理框" />
  </Choices>
  <TextArea name="annotator_note" toName="image" rows="2" placeholder="只记录改变判断的证据或歧义；音频不可用写 audio_unavailable" />
</View>
